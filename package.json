{
  "name": "lumen",
  "version": "0.1.0",
  "description": "本地优先的AI知识库桌面应用",
  "main": "dist-electron/main.js",
  "author": "鲁佳华",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist": "npm run build && electron-builder --win",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "tsc && vite build"
  },
  "build": {
    "appId": "com.lumen.app",
    "productName": "Lumen",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Lumen"
    }
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.37.0",
    "@xenova/transformers": "^2.17.2",
    "apache-arrow": "^21.2.0",
    "better-sqlite3": "^11.7.0",
    "mammoth": "^1.8.0",
    "marked": "^15.0.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "33.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "keywords": [],
  "allowScripts": {}
}
